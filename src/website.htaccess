# Ordner /website/ – statische Website, erzeugt von GitHub (nicht von Hand ändern)
Options -Indexes
DirectoryIndex index.html index.xml

# Versteckte Dateien (z. B. Abgleichsliste des Hochladens) nicht ausliefern
<FilesMatch "^\.">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
# Direkter Aufruf über /website/… → nicht gefunden.
# Die Seiten erscheinen nur über die Regeln in der .htaccess des Hauptordners (ohne /website/ in der Adresse).
RewriteCond %{THE_REQUEST} \s/+website[/?\s] [NC]
RewriteRule ^ - [R=404,L]
</IfModule>

# Testadresse: nicht in Suchmaschinen aufnehmen
<IfModule mod_headers.c>
<If "%{HTTP_HOST} == 'neu.finkeldei-online.de'">
Header always set X-Robots-Tag "noindex, nofollow"
</If>
</IfModule>

# Zwischenspeichern im Browser (bisher von FlyingPress im Hauptordner gesetzt)
# Seiten und Sitemaps immer frisch prüfen; Stylesheet, Skripte und Bilder tragen eine Versionskennung (?v=…)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/xml "access plus 0 seconds"
ExpiresByType application/xml "access plus 0 seconds"
ExpiresByType application/rss+xml "access plus 0 seconds"
ExpiresByType application/json "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

# Komprimierung (bisher von FlyingPress im Hauptordner gesetzt)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

