---
pagination:
  data: wp.archives
  size: 1
  alias: arc
permalink: "{{ arc.path }}"
layout: layouts/base.njk
---
{#- Archivseiten im Layout C -#}
<section class="pc-hero pc-plain pc-post">
  <div class="pc-hero-in">
    <div class="pc-text">
      <p class="pc-kicker">{% if arc.kind == 'blog' %}<a href="/">{{ site.name }}</a>{% else %}<a href="/meldungen/">Meldungen</a> › {% if arc.kind == 'category' %}Kategorie{% else %}Schlagwort{% endif %}{% endif %}</p>
      <h1>{% if arc.kind == 'category' %}Kategorie: {% elif arc.kind == 'tag' %}Schlagwort: {% endif %}{{ arc.title }}</h1>
      {%- if arc.total > 1 %}<p class="pc-date">Seite {{ arc.num }} von {{ arc.total }}</p>{% endif %}
    </div>
  </div>
</section>
<div class="pc-body">
  <ul class="post-list pc-list">
    {%- for p in arc.posts %}
    <li>
      <a class="post-card" href="{{ p.path }}">
        <span class="post-date">{{ p.date | dateDE }}{% if p.categories.length %} · {{ p.categories[0].name }}{% endif %}</span>
        <b>{{ p.title }}</b>
        {%- if p.excerpt %}<span class="post-excerpt">{{ p.excerpt | truncate(220) }}</span>{% endif %}
      </a>
    </li>
    {%- endfor %}
  </ul>
  {%- if arc.total > 1 %}
  <nav class="pager" aria-label="Seiten">
    {% if arc.prev %}<a href="{{ arc.prev }}">← Neuere Beiträge</a>{% else %}<span></span>{% endif %}
    {% if arc.next %}<a href="{{ arc.next }}">Ältere Beiträge →</a>{% endif %}
  </nav>
  {%- endif %}
</div>
{% include "partials/page-end.njk" %}
