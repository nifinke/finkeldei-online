<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "partials/consent-head.njk" %}
<title>{{ seo.title }}</title>
{%- if seo.description %}
<meta name="description" content="{{ seo.description }}">
{%- endif %}
{%- if build.noindex %}
<meta name="robots" content="noindex, nofollow">
{%- elif seo.robots and (seo.robots.index or seo.robots.follow) %}
<meta name="robots" content="{% for k, v in seo.robots %}{{ v }}{% if not loop.last %}, {% endif %}{% endfor %}">
{%- endif %}
{%- if page.url == "/" and site.googleVerification %}
<meta name="google-site-verification" content="{{ site.googleVerification }}">
{%- endif %}
<link rel="canonical" href="{{ seo.canonical or (site.url + page.url) }}">
<meta property="og:locale" content="de_DE">
<meta property="og:type" content="{{ seo.ogType or 'website' }}">
<meta property="og:title" content="{{ seo.ogTitle or seo.title }}">
{%- if seo.ogDescription or seo.description %}
<meta property="og:description" content="{{ seo.ogDescription or seo.description }}">
{%- endif %}
<meta property="og:url" content="{{ seo.canonical or (site.url + page.url) }}">
<meta property="og:site_name" content="{{ seo.ogSiteName or site.seoName }}">
{%- if seo.articlePublisher %}
<meta property="article:publisher" content="{{ seo.articlePublisher }}">
{%- endif %}
{%- if seo.publishedTime %}
<meta property="article:published_time" content="{{ seo.publishedTime }}">
{%- endif %}
{%- if seo.modifiedTime %}
<meta property="article:modified_time" content="{{ seo.modifiedTime }}">
{%- endif %}
{%- if seo.ogImage %}
<meta property="og:image" content="{{ seo.ogImage }}">
{%- if seo.ogImageWidth %}
<meta property="og:image:width" content="{{ seo.ogImageWidth }}">
<meta property="og:image:height" content="{{ seo.ogImageHeight }}">
{%- endif %}
{%- if seo.ogImageType %}
<meta property="og:image:type" content="{{ seo.ogImageType }}">
{%- endif %}
{%- endif %}
{%- if seo.author %}
<meta name="author" content="{{ seo.author }}">
{%- endif %}
<meta name="twitter:card" content="{{ seo.twitterCard or 'summary_large_image' }}">
{%- if seo.twitterCreator %}
<meta name="twitter:creator" content="{{ seo.twitterCreator }}">
{%- endif %}
<meta name="twitter:site" content="{{ seo.twitterSite or site.twitter }}">
{%- for m in seo.twitterMisc %}
<meta name="twitter:label{{ loop.index }}" content="{{ m[0] }}">
<meta name="twitter:data{{ loop.index }}" content="{{ m[1] }}">
{%- endfor %}
<link rel="icon" href="{{ site.favicon }}" sizes="32x32">
<link rel="icon" href="{{ site.favicon }}" sizes="192x192">
<link rel="apple-touch-icon" href="{{ site.favicon }}">
<meta name="msapplication-TileImage" content="{{ site.favicon }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.seoName }} &raquo; Feed" href="{{ site.url }}/feed/">
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
{%- if seo.schema %}
<script type="application/ld+json">{{ seo.schema | json | safe }}</script>
{%- endif %}
{%- block schema %}{% endblock %}
{%- set vid = videos.byPath[page.url] %}
{%- if vid %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": vid.title,
  "description": vid.description,
  "thumbnailUrl": vid.thumbnailLoc,
  "uploadDate": vid.publicationDate,
  "duration": vid.duration | isoDuration,
  "contentUrl": vid.contentLoc,
  "inLanguage": "de",
  "isFamilyFriendly": vid.familyFriendly == "yes"
} | json | safe }}</script>
{%- endif %}
</head>
<body>
{%- if build.preview %}
<div style="background:#fff7d6;border-bottom:1px solid #f0dc8a;color:#6b5400;font-size:13px;text-align:center;padding:7px 16px">Vorschau (Phase 3) – nicht live. Formulare und Rechner folgen in Phase 3. <a href="/pruefbericht/" style="color:inherit">Prüfbericht</a></div>
{%- endif %}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="defringe" color-interpolation-filters="sRGB"><feMorphology in="SourceAlpha" operator="erode" radius="2" result="e"/><feGaussianBlur in="e" stdDeviation="0.6" result="b"/><feComposite in="SourceGraphic" in2="b" operator="in"/></filter>
  <filter id="defringe-sm" color-interpolation-filters="sRGB"><feMorphology in="SourceAlpha" operator="erode" radius="0.8" result="e"/><feGaussianBlur in="e" stdDeviation="0.4" result="b"/><feComposite in="SourceGraphic" in2="b" operator="in"/></filter>
</svg>
{% include "partials/header.njk" %}
<main>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<div class="callbar"><a class="btn btn-navy" href="tel:{{ site.phoneHref }}">📞 Anrufen</a><a class="btn btn-line" href="mailto:{{ site.email }}">✉️ E-Mail</a></div>
{% include "partials/consent-banner.njk" %}
<script>window.fxConfig={endpoint:"{{ site.formEndpoint }}"};</script>
<script src="/assets/js/forms.js?v={{ build.version }}" defer></script>
<script src="/assets/js/kostenrechner.js?v={{ build.version }}" defer></script>
</body>
</html>
